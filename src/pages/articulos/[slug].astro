---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSidebar from '../../components/AdSidebar.astro';

// 1. Generamos las rutas dinámicas para cada artículo de la colección
export async function getStaticPaths() {
    const articulos = await getCollection('articulos');
    return articulos.map(articulo => ({
        params: { slug: articulo.slug },
        props: { articulo },
    }));
}

// 2. Recuperamos el artículo correspondiente a la URL
const { articulo } = Astro.props;
const { Content } = await articulo.render();
---

<Layout title={`${articulo.data.title} | Factor Agua+`}>
    <Header />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- CONTENIDO PRINCIPAL DEL ARTÍCULO -->
            <article class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-2xl shadow-sm border border-slate-200">
                
                <!-- Metadatos -->
                <div class="flex items-center gap-3 mb-4">
                    <span class="bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md">
                        {articulo.data.category}
                    </span>
                    <span class="text-xs text-slate-400 font-medium">
                        {articulo.data.date}
                    </span>
                    {articulo.data.author && (
                        <span class="text-xs text-slate-500 font-medium">
                            • Por {articulo.data.author}
                        </span>
                    )}
                </div>

                <!-- Título -->
                <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-6 leading-tight">
                    {articulo.data.title}
                </h1>

                <!-- Imagen Destacada -->
                {articulo.data.image && (
                    <div class="mb-8 overflow-hidden rounded-xl bg-slate-100 max-h-[400px]">
                        <img 
                            src={articulo.data.image} 
                            alt={articulo.data.title} 
                            class="w-full h-full object-cover"
                        />
                    </div>
                )}

                <!-- Cuerpo del Artículo renderizado desde Markdown -->
                <div class="prose prose-slate max-w-none prose-headings:font-bold prose-a:text-emerald-600">
                    <Content />
                </div>

                <!-- Botón de Retorno -->
                <div class="mt-10 pt-6 border-t border-slate-100">
                    <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-600 hover:text-emerald-800 transition">
                        ← Volver a la Portada
                    </a>
                </div>
            </article>

            <!-- SIDEBAR LATERAL -->
            <div class="lg:col-span-4">
                <AdSidebar />
            </div>

        </div>
    </main>

    <Footer />
</Layout>