---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSidebar from '../components/AdSidebar.astro';
import Footer from '../components/Footer.astro';

// Obtenemos los artículos de forma segura
let articulos = [];
try {
    articulos = await getCollection('articulos');
    articulos.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
} catch (e) {
    console.error("Error al cargar la colección:", e);
}

const articuloPrincipal = articulos.length > 0 ? articulos[0] : null;
const restoArticulos = articulos.length > 1 ? articulos.slice(1) : [];
---

<Layout title="Factor Agua+ | Periodismo Especializado en Riego y Tecnología">
	
	<Header />

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
			
			<div class="lg:col-span-8 space-y-8">
				
				{articuloPrincipal ? (
					<section>
						<div class="flex items-center justify-between mb-4 border-b-2 border-slate-900 pb-2">
							<h2 class="text-xl font-black uppercase text-slate-900 tracking-tight flex items-center gap-2">
								<span class="text-emerald-600">⭐</span> Tema de Portada
							</h2>
						</div>
						<ArticleCard 
							title={articuloPrincipal.data.title}
							category={articuloPrincipal.data.category}
							date={articuloPrincipal.data.date}
							excerpt={articuloPrincipal.data.excerpt}
							image={articuloPrincipal.data.image || "https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=800&q=80"}
							slug={articuloPrincipal.slug}
							isFeatured={true} 
						/>
					</section>
				) : (
					<div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl">
						<p class="font-bold">Aviso:</p>
						<p class="text-sm">No se encontraron artículos en la colección. Verifica que el archivo Markdown esté guardado en <strong>src/content/articulos/</strong>.</p>
					</div>
				)}

				<a href="mailto:factoragua2026@gmail.com?subject=Consulta%20sobre%20publicidad%20en%20Factor%20Agua" class="bg-slate-200 border-2 border-dashed border-slate-300 rounded-xl p-6 flex flex-col items-center justify-center text-center relative group hover:border-emerald-600 transition block">
					<span class="absolute top-1 right-2 text-[9px] uppercase tracking-wider text-slate-400 font-bold">Publicidad (In-Feed)</span>
					<p class="text-slate-800 font-bold text-base group-hover:text-emerald-600">¿Eres fabricante de tuberías, bombas o sensores de riego?</p>
					<p class="text-slate-500 text-xs mt-1">Anuncia tu marca en esta sección clave con más de 20,000 lecturas mensuales.</p>
				</a>

				<section id="ultimas-publicaciones">
					<div class="flex items-center justify-between mb-4 border-b-2 border-slate-900 pb-2">
						<h2 class="text-xl font-black uppercase text-slate-900 tracking-tight">
							Últimas Publicaciones
						</h2>
						<a href="#ultimas-publicaciones" class="text-xs font-bold text-emerald-600 hover:underline">Ver todas ➔</a>
					</div>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						{restoArticulos.map(article => (
							<ArticleCard 
								title={article.data.title}
								category={article.data.category}
								date={article.data.date}
								excerpt={article.data.excerpt}
								image={article.data.image || "https://images.unsplash.com/photo-1592417817098-8f3d6eb231fc?auto=format&fit=crop&w=600&q=80"}
								slug={article.slug}
							/>
						))}
					</div>
				</section>
			</div>

			<div class="lg:col-span-4">
				<AdSidebar />
			</div>

		</div>
	</div>

	<Footer />

</Layout>