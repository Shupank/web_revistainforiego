---
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css'; // <-- ¡Esta línea es la clave para que cargue Tailwind!

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Revista Digital Especializada en Riego Agrícola, AgTech y Sostenibilidad" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Favicon oficial de la revista -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

		<title>{title} | Factor Agua+</title>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">
		
		<!-- CONTENIDO PRINCIPAL -->
		<main class="flex-grow w-full">
			<slot />
		</main>

		<!-- FOOTER MODULAR -->
		<Footer />

		<!-- MODAL DE CONTACTO UNIVERSAL -->
		<ContactModal />

		<!-- ANALÍTICAS DE VERCEL -->
		<Analytics />
	</body>
</html>