---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Revista Digital Especializada en Riego Agrícola, AgTech y Sostenibilidad" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Factor Agua</title>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">
		
		<!-- CONTENIDO PRINCIPAL (El Header moderno se importa en cada página) -->
		<main class="flex-grow w-full">
			<slot />
		</main>

		<!-- FOOTER -->
		<footer class="bg-slate-900 text-slate-400 text-sm mt-12 border-t border-slate-800">
			<!-- NEWSLETTER STRIP -->
			<div id="newsletter" class="bg-emerald-700 text-white py-10">
				<div class="max-w-7xl mx-auto px-4 text-center">
					<h3 class="text-2xl font-black mb-2">Recibe las últimas novedades sobre Riego en tu correo</h3>
					<p class="text-slate-100 text-sm mb-6 max-w-xl mx-auto">Únete a más de 5,000 ingenieros agrónomos, productores y especialistas en gestión hídrica.</p>
					<form class="flex flex-col sm:flex-row justify-center max-w-md mx-auto gap-2">
						<input type="email" placeholder="Tu correo electrónico profesional" class="px-4 py-3 rounded-lg text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 w-full" required />
						<button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3 rounded-lg transition text-xs uppercase tracking-wider whitespace-nowrap">
							Suscribirme
						</button>
					</form>
				</div>
			</div>

			<div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
				<div>
					<div class="flex items-center gap-2 mb-4">
						<span class="text-xl font-black tracking-tight text-white">CAMPO <span class="text-emerald-400">&</span> RIEGO</span>
					</div>
					<p class="text-xs leading-relaxed text-slate-400">La publicación líder en información técnica, innovación en irrigación, uso eficiente del agua y tecnología agrícola B2B.</p>
				</div>
				<div>
					<h4 class="text-white font-bold text-sm mb-4 border-b border-slate-800 pb-2">Secciones</h4>
					<ul class="space-y-2 text-xs">
						<li><a href="#" class="hover:text-white transition">Riego por Goteo y Aspersión</a></li>
						<li><a href="#" class="hover:text-white transition">Sensores e IoT Agrícola</a></li>
						<li><a href="#" class="hover:text-white transition">Gestión de Acuíferos</a></li>
						<li><a href="#" class="hover:text-white transition">Entrevistas & Casos de Éxito</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-bold text-sm mb-4 border-b border-slate-800 pb-2">Anunciantes & Marcas</h4>
					<ul class="space-y-2 text-xs">
						<li><a href="#" class="hover:text-white transition">Media Kit / Tarifario Publicitario</a></li>
						<li><a href="#" class="hover:text-white transition">Guía de Proveedores de Riego</a></li>
						<li><a href="#" class="hover:text-white transition">Publicar Nota Patrocinada</a></li>
						<li><a href="#" class="hover:text-white transition">Contacto Comercial</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-bold text-sm mb-4 border-b border-slate-800 pb-2">Contacto</h4>
					<p class="text-xs text-slate-400 mb-2">¿Tienes una noticia o proyecto de riego para compartir?</p>
					<a href="mailto:redaccion@factoragua.com" class="text-emerald-400 font-bold text-xs hover:underline block">redaccion@factoragua</a>
				</div>
			</div>
			
			<div class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
				<p>© {new Date().getFullYear()} Revista Factor Agua. Todos los derechos reservados.</p>
			</div>
		</footer>
	</body>
</html>