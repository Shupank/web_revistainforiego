---
// src/components/AdSidebar.astro
---

<aside class="space-y-6">
	<!-- BLOQUE DE SUSCRIPCIÓN / NEWSLETTER -->
	<div class="bg-slate-900 text-white p-6 rounded-xl shadow-lg border border-slate-800">
		<span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950 px-2 py-1 rounded border border-emerald-800">Comunidad</span>
		<h3 class="text-xl font-bold mt-3 mb-2">Suscríbete a Factor Agua+</h3>
		<p class="text-slate-300 text-xs mb-4">Recibe las últimas novedades sobre AgTech, riego presurizado y gestión hídrica directamente en tu correo.</p>
		
		<a 
			href="#contacto"
			class="open-contact-modal block w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase py-2.5 rounded-lg transition shadow-sm"
		>
			Unirme al newsletter
		</a>
	</div>

	<!-- BANNER PUBLICITARIO: WISFLOW -->
	<div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
		<div class="px-3 py-1.5 bg-slate-50 border-b border-slate-100 flex items-center justify-between">
			<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Publicidad</span>
			<span class="text-[10px] font-semibold text-emerald-700">Wisflow</span>
		</div>
		<a
			href="https://www.wisflow.uy/"
			target="_blank"
			rel="noopener noreferrer"
			class="block group focus:outline-none"
			aria-label="Visitar el sitio web de Wisflow - Control de riego 100% inalámbrico"
		>
			<img
				src="/banner-wisflow.png"
				alt="Wisflow - Control de riego 100% inalámbrico: sin zanjeos ni cables, panel solar, hasta 5 km y alertas por WhatsApp"
				class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.01]"
			/>
		</a>
	</div>

	<!-- BLOQUE DE CONSULTAS TÉCNICAS -->
	<div class="bg-white border border-slate-200 p-6 rounded-xl shadow-sm">
		<h4 class="font-bold text-slate-900 text-sm mb-2 uppercase tracking-wide">¿Consultas Técnicas?</h4>
		<p class="text-slate-600 text-xs mb-4 leading-relaxed">
			Espacio abierto para profesionales e investigadores del sector agropecuario y de riego.
		</p>
		<a 
			href="#contacto"
			class="open-contact-modal inline-block text-emerald-600 font-bold text-xs hover:underline"
		>
			Escríbenos a la redacción ➔
		</a>
	</div>
</aside>