---
// src/components/Header.astro
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
  <!-- Barra superior de utilidades -->
  <div class="bg-slate-900 text-slate-300 py-1.5 px-4 text-xs">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-4">
        <span class="bg-emerald-600 text-white px-2 py-0.5 rounded font-bold uppercase text-[10px]">Edición Digital</span>
        <span class="hidden sm:inline">Viernes, 30 de Octubre de 2026</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="#newsletter" class="hover:text-white transition">Newsletter</a>
        <span>|</span>
        <a href="#contacto" class="hover:text-white transition">Contáctanos</a>
      </div>
    </div>
  </div>

  <!-- Cabecera Central con el Logotipo -->
  <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
    <a href="/" class="flex items-center gap-3 group">
      <!-- Aquí puedes reemplazar la ruta por la ubicación real de tu logo en la carpeta public -->
      <img src="/images/logo-factor-agua.jpg" alt="Factor Agua" class="h-20 sm:h-24 w-auto object-contain" />
    </a>

    <!-- Botón Suscribir -->
    <div class="flex items-center gap-3">
      <a href="#suscribirse" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase px-5 py-2.5 rounded transition shadow-sm">
        Suscribirse
      </a>
    </div>
  </div>

  <!-- Barra de Categorías / Menú de Navegación -->
  <nav class="border-t border-slate-200 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 flex overflow-x-auto whitespace-nowrap gap-8 text-xs font-bold uppercase tracking-wider text-slate-700 py-3">
      <a href="#" class="hover:text-emerald-600 transition border-b-2 border-emerald-600 pb-1">Portada</a>
      <a href="#" class="hover:text-emerald-600 transition">Riego Agrícola</a>
      <a href="#" class="hover:text-emerald-600 transition">Tecnología & AgTech</a>
      <a href="#" class="hover:text-emerald-600 transition">Sostenibilidad</a>
      <a href="#" class="hover:text-emerald-600 transition">Regionales</a>
      <a href="#" class="hover:text-emerald-600 transition">Clima y Suelos</a>
      <a href="#" class="hover:text-emerald-600 transition">Entrevistas</a>
    </div>
  </nav>
</header>