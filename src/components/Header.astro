---
// Generamos la fecha actual de forma dinámica en español
const fechaActual = new Date().toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Capitalizamos la primera letra (ej. "martes" -> "Martes")
const fechaFormateada = fechaActual.charAt(0).toUpperCase() + fechaActual.slice(1);
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
	<!-- Barra superior de utilidades -->
	<div class="bg-slate-900 text-slate-300 py-1.5 px-4 text-xs">
		<div class="max-w-7xl mx-auto flex justify-between items-center">
			<div class="flex items-center gap-4">
				<span class="bg-emerald-600 text-white px-2 py-0.5 rounded font-bold uppercase text-[10px]">Edición Digital</span>
				<!-- Fecha dinámica generada automáticamente -->
				<span class="hidden sm:inline">{fechaFormateada}</span>
			</div>
			<div class="flex items-center gap-3">
				<a href="#newsletter" class="hover:text-white transition">Newsletter</a>
				<span>|</span>
				<a href="#contacto" class="hover:text-white transition">Contáctanos</a>
			</div>
		</div>
	</div>

	<!-- Cabecera Central con el Logotipo -->
	<div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
		<a href="/" class="flex items-center gap-3 group">
			<img src="/images/logo-factor-agua.jpg" alt="Factor Agua" class="h-20 sm:h-24 w-auto object-contain" />
		</a>

		<!-- Botón Suscribir -->
		<div class="flex items-center gap-3">
			<a href="#suscribirse" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase px-5 py-2.5 rounded transition shadow-sm">
				Suscribirse
			</a>
		</div>
	</div>

	<!-- Barra de Categorías / Menú de Navegación Responsivo -->
	<div class="border-t border-slate-100 bg-white">
		<!-- Versión Móvil: Scroll Horizontal con el dedo -->
		<div class="md:hidden overflow-x-auto px-4 py-2.5 scrollbar-none">
			<nav class="flex space-x-6 text-xs font-bold uppercase tracking-wider text-slate-700 whitespace-nowrap">
				<a href="/" class="hover:text-emerald-600 transition">Portada</a>
				<a href="/categorias/riego-agricola" class="hover:text-emerald-600 transition">Riego Agrícola</a>
				<a href="/categorias/tecnologia-agtech" class="hover:text-emerald-600 transition">Tecnología & AgTech</a>
				<a href="/categorias/sostenibilidad" class="hover:text-emerald-600 transition">Sostenibilidad</a>
				<a href="/categorias/regionales" class="hover:text-emerald-600 transition">Regionales</a>
				<a href="/categorias/clima-y-suelos" class="hover:text-emerald-600 transition">Clima y Suelos</a>
				<a href="/categorias/entrevistas" class="hover:text-emerald-600 transition">Entrevistas</a>
			</nav>
		</div>

		<!-- Versión Desktop y Tablets: Flex Wrap y Centrado -->
		<div class="hidden md:block max-w-7xl mx-auto px-4">
			<nav class="flex flex-wrap justify-center lg:justify-start items-center gap-x-6 gap-y-2 py-3 text-xs font-bold uppercase tracking-wider text-slate-700">
				<a href="/" class="hover:text-emerald-600 transition py-1">Portada</a>
				<a href="/categorias/riego-agricola" class="hover:text-emerald-600 transition py-1">Riego Agrícola</a>
				<a href="/categorias/tecnologia-agtech" class="hover:text-emerald-600 transition py-1">Tecnología & AgTech</a>
				<a href="/categorias/sostenibilidad" class="hover:text-emerald-600 transition py-1">Sostenibilidad</a>
				<a href="/categorias/regionales" class="hover:text-emerald-600 transition py-1">Regionales</a>
				<a href="/categorias/clima-y-suelos" class="hover:text-emerald-600 transition py-1">Clima y Suelos</a>
				<a href="/categorias/entrevistas" class="hover:text-emerald-600 transition py-1">Entrevistas</a>
			</nav>
		</div>
	</div>
</header>